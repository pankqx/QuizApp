@* ============================================================
   FILE: Views/Shared/_Layout.cshtml
   PROJECT: QuizApp — ASP.NET Core MVC
   DESCRIPTION: Master layout page used by all views.
                Contains the navbar, footer, and Bootstrap CDN.
                Navbar items change dynamically based on user role:
                  - Admin sees: Manage Tests | All Results | Logout
                  - Student sees: My Tests | Logout
                  - Unauthenticated users see nothing in the navbar
   ============================================================ *@

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QuizApp</title>

    {{!-- Bootstrap 5 CSS loaded from CDN --}}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
          crossorigin="anonymous" />

    {{!-- Custom site styles --}}
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="bg-light">

    {{!-- ── Top Navigation Bar ── --}}
    <nav class="navbar navbar-expand-md navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">QuizApp</a>

            {{!-- Mobile toggle button --}}
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navMenu">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <ul class="navbar-nav ms-auto align-items-center">

                        @* Show different nav links based on role *@
                        @if (User.IsInRole("Admin"))
                        {
                            {{!-- Admin navigation links --}}
                            <li class="nav-item">
                                <a class="nav-link" href="/Admin">Manage Tests</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/Admin/Results">All Results</a>
                            </li>
                        }
                        else
                        {
                            {{!-- Student navigation links --}}
                            <li class="nav-item">
                                <a class="nav-link" href="/Home">My Tests</a>
                            </li>
                        }

                        {{!-- Logout button (POST to prevent CSRF logout via link) --}}
                        <li class="nav-item ms-2">
                            <form method="post" action="/Account/Logout">
                                <button type="submit" class="btn btn-outline-light btn-sm">Logout</button>
                            </form>
                        </li>

                    </ul>
                }
            </div>
        </div>
    </nav>

    {{!-- ── Page Content (injected by each view) ── --}}
    <main class="container py-4">
        @RenderBody()
    </main>

    {{!-- ── Footer ── --}}
    <footer class="border-top bg-white py-3 mt-4">
        <div class="container text-center text-muted small">
            &copy; 2025 QuizApp &mdash; Academic Project
        </div>
    </footer>

    {{!-- Bootstrap 5 JS loaded from CDN --}}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc4s9bIOgUxi8T/jzmBIEr0p4QKa6Bi2M+5h+y6f9WC"
            crossorigin="anonymous"></script>

    @* Optional scripts section — individual views can inject page-specific JS *@
    @RenderSection("Scripts", required: false)
</body>
</html>
