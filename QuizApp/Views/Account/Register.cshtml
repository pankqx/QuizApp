@* ============================================================
   FILE: Views/Account/Register.cshtml
   MODULE 1: Registration Page
   DESCRIPTION: Registration form for new users.
                Allows selecting account type: Student or Admin.
                On success, redirects to Login page.
   ============================================================ *@

@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h2 class="card-title text-center mb-4">Create Account</h2>

                @* Shows model-level errors (e.g. duplicate email) *@
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <form asp-action="Register" method="post">

                    @* Full Name field *@
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label">Full Name</label>
                        <input asp-for="FullName" class="form-control" placeholder="John Doe" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    @* Email field *@
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" placeholder="you@example.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    @* Password field *@
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    @* Role dropdown — Student (default) or Admin *@
                    <div class="mb-3">
                        <label asp-for="Role" class="form-label">Account Type</label>
                        <select asp-for="Role" class="form-select">
                            <option value="Student">Student</option>
                            <option value="Admin">Admin (Teacher / Host)</option>
                        </select>
                    </div>

                    @* Submit button *@
                    <div class="d-grid mt-4">
                        <button type="submit" class="btn btn-success">Register</button>
                    </div>
                </form>

                @* Link back to Login page *@
                <p class="text-center mt-3 mb-0 small">
                    Already have an account?
                    <a asp-controller="Account" asp-action="Login">Login here</a>
                </p>

            </div>
        </div>
    </div>
</div>
